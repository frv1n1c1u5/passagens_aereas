# Amadeus Self-Service API credentials (get from https://developers.amadeus.com)
AMADEUS_CLIENT_ID=replace-me
AMADEUS_CLIENT_SECRET=replace-me

# "test" (sandbox) or "production"
AMADEUS_ENV=test

# Backend
DEFAULT_CURRENCY=BRL
MAX_PARALLEL_AMADEUS=4
FLEX_MATRIX_BAND=1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Frontend (server-side: how Next reaches backend inside Docker network)
BACKEND_INTERNAL_URL=http://backend:8000
